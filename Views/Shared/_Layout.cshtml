<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore | Hồng Quân Bookstore</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/Site.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        var cartObj = Session["Cart"] as _25dh190025_NguyenHuynhHongQuan.Models.ViewModel.Cart;
        int cartCount = cartObj != null && cartObj.Items != null ? cartObj.Items.Sum(i => i.Quantity) : 0;

        List<_25dh190025_NguyenHuynhHongQuan.Models.Category> navCategories = new List<_25dh190025_NguyenHuynhHongQuan.Models.Category>();
        try
        {
            using (var dbNav = new _25dh190025_NguyenHuynhHongQuan.Models.MyStoreEntities())
            {
                navCategories = dbNav.Categories.ToList();
            }
        }
        catch { }
    }

    <!-- Thanh thông báo đơn giản -->
    <div class="py-1 text-center text-white small" style="background-color: #1B4332; letter-spacing: 0.3px;">
        Chào mừng đến với MyStore — Miễn phí vận chuyển toàn quốc cho đơn hàng từ 200.000đ!
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-nature sticky-top">
        <div class="container">
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none py-1">
                <span style="font-size: 20px;">🌿</span>
                <span class="fw-bold" style="font-size: 1.25rem; color: #FFFFFF;">MyStore</span>
            </a>
            
            <button type="button" class="navbar-toggler border-0 shadow-none" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-lg-inline-flex justify-content-between">
                <ul class="navbar-nav mx-auto align-items-center gap-1 my-2 my-lg-0">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home", new { area = "" })" class="nav-link">
                            Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("ProductCategory", "Home", new { area = "" })" class="nav-link">
                            Tất cả sách
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarCategoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Danh mục sách
                        </a>
                        <ul class="dropdown-menu shadow border-0 py-2" aria-labelledby="navbarCategoryDropdown" style="max-height: 400px; overflow-y: auto;">
                            <li>
                                <a class="dropdown-item fw-bold text-success py-2" href="@Url.Action("ProductCategory", "Home", new { area = "" })">
                                    Xem tất cả danh mục
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            @foreach (var cat in navCategories)
                            {
                                <li>
                                    <a class="dropdown-item py-1" href="@Url.Action("ProductCategory", "Home", new { area = "", categoryId = cat.CategoryID })">
                                        @cat.CategoryName
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-center gap-2">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Cart", new { area = "" })" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2 px-3 py-1" style="border-radius: 4px;">
                            <span>🛒</span>
                            <span>Giỏ hàng</span>
                            <span class="badge bg-danger">@cartCount</span>
                        </a>
                    </li>
                    @if (Session["Username"] != null || User.Identity.IsAuthenticated)
                    {
                        var role = (Session["UserRole"] as string ?? "").Trim();
                        bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || role.Equals("A", StringComparison.OrdinalIgnoreCase);
                        string displayName = (Session["FullName"] ?? Session["Username"] ?? User.Identity.Name).ToString();

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 py-1 text-white fw-semibold" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                👤 @displayName @(isAdmin ? " (Admin)" : "")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-1" aria-labelledby="userMenuDropdown">
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("ProfileInfo", "Account", new { area = "" })">
                                        Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("MyOrder", "Order", new { area = "" })">
                                        Lịch sử đơn hàng
                                    </a>
                                </li>
                                @if (isAdmin)
                                {
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-success fw-bold" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                                            ⚙️ Trang quản trị (Admin)
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account", new { area = "" })">
                                        Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, new { @class = "nav-link px-2" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Đăng ký", "Register", "Account", new { area = "" }, new { @class = "btn btn-outline-light btn-sm px-3", style = "border-radius: 4px;" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container body-content py-3">
        @RenderBody()
    </div>

    <!-- Footer đơn giản, tinh tế -->
    <footer class="mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-md-5">
                    <h5 class="text-white fw-bold mb-2">🌿 MyStore</h5>
                    <p class="small text-muted mb-0" style="color: #B7E4C7 !important; max-width: 380px;">
                        Hệ thống sách & sản phẩm văn hóa hướng đến lối sống bền vững và tri thức. Cam kết 100% sách chính hãng, chất lượng và dịch vụ tận tâm.
                    </p>
                </div>
                <div class="col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-2">Liên kết</h6>
                    <ul class="list-unstyled small mb-0" style="line-height: 2;">
                        <li><a href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a></li>
                        <li><a href="@Url.Action("ProductCategory", "Home", new { area = "" })">Tất cả sách</a></li>
                        <li><a href="@Url.Action("Index", "Cart", new { area = "" })">Giỏ hàng</a></li>
                    </ul>
                </div>
                <div class="col-md-4 col-6">
                    <h6 class="text-white fw-bold mb-2">Đồ án môn học</h6>
                    <div class="small" style="color: #B7E4C7 !important; line-height: 1.8;">
                        <div>Sinh viên thực hiện: <strong class="text-white">Nguyễn Huỳnh Hồng Quân</strong></div>
                        <div>MSSV: <strong class="text-white">25DH190025</strong></div>
                        <div>Khoa Công Nghệ Thông Tin</div>
                    </div>
                </div>
            </div>

            <hr style="border-color: rgba(255,255,255,0.15);" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small text-muted" style="color: #A7D7BC !important;">
                <div>
                    &copy; @DateTime.Now.Year <strong>MyStore</strong> — Sinh viên: <strong>Nguyễn Huỳnh Hồng Quân (25DH190025)</strong>.
                </div>
                <div>
                    Nền tảng <strong>ASP.NET MVC 5 & Entity Framework 6</strong>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
